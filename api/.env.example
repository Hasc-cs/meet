# Copy this file to .env and fill in real values.
# .env.example is committed to git; .env is NOT.

# App
APP_NAME=api
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Secrets (generate your own, never commit real values)
SECRET_KEY=change-me

# ---------- Photos ----------
# Limits the API enforces (the web app reads them from /api/models).
MAX_IMAGES_PER_MESSAGE=5
MAX_IMAGES_PER_REQUEST=20
MAX_IMAGE_BYTES=10485760
# Ollama reports which models can see images. Cloud models are matched by name;
# add patterns here for any the rules miss, e.g. ["my-org/*-vl"].
VISION_MODELS=[]

